# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Add the exact GitHub Pages origin before publishing.
CORS_ORIGINS=http://localhost:5173,https://YOUR_GITHUB_USER.github.io
# Token from Cloudflare Networking > Tunnels. Required only for the public profile.
TUNNEL_TOKEN=